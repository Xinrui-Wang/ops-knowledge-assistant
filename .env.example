# 复制为 .env 后填入自己的 key（.env 已被 gitignore）
# 任意 OpenAI 兼容服务均可：把 BASE_URL / MODEL 换成对应值即可

OKA_LLM_BASE_URL=https://api.siliconflow.cn/v1
OKA_LLM_API_KEY=
OKA_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

OKA_EMBED_BASE_URL=https://api.siliconflow.cn/v1
OKA_EMBED_API_KEY=
OKA_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
OKA_EMBED_DIMENSIONS=1024
